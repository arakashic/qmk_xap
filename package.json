{
    "name": "qmk-xap-gui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "tauri build",
        "build:wasm": "PATH=\"$(dirname \"$(rustup which rustc)\")\":$PATH wasm-pack build xap-wasm --target web --out-dir ../src/generated/xap-wasm --dev",
        "check": "cd src-tauri && cargo check",
        "dev": "RUST_BACKTRACE=1 tauri dev",
        "format": "prettier --write .",
        "preview": "vite preview",
        "sync:keycodes": "python3 xap-specs/scripts/sync_keycodes.py",
        "test": "vitest",
        "ts-check": "tsc --noEmit",
        "vite:build": "vite build",
        "vite:build:mock": "VITE_MOCK=1 vite build",
        "vite:dev": "vite dev",
        "vite:dev:mock": "VITE_MOCK=1 vite dev"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-popover": "^1.1.14",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-slider": "^1.3.5",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-tabs": "^1.1.15",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tanstack/react-query": "^5.101.0",
        "@tauri-apps/api": "2.0.0-beta.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.2.7",
        "react-aria-components": "^1.10.0",
        "react-dom": "^19.2.7",
        "tailwind-merge": "^3.6.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@tauri-apps/cli": "~2.0.0-beta.17",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "~20.12.12",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "~7.10.0",
        "@typescript-eslint/parser": "~7.10.0",
        "@vitejs/plugin-react": "4",
        "autoprefixer": "^10.4.19",
        "eslint": "~8.6.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-n": "17.7.0",
        "eslint-plugin-security": "3.0.0",
        "jsdom": "^29.1.1",
        "postcss": "^8.4.38",
        "prettier": "3.2.5",
        "tailwindcss": "^3.4.3",
        "typescript": "~5.4.5",
        "vite": "~5.2.11",
        "vitest": "1.6.0"
    }
}
