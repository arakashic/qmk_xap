        "QK_MAGIC_EE_HANDS_RIGHT":             { "description": "Set the master half of a split keyboard as the right hand (for EE_HANDS)" },

        // QK_BOOTLOADER label override remains (not in basic/magic docs but useful).
        "QK_BOOTLOADER": { "label": "Bootloader", "description": "Reset the keyboard into bootloader mode for flashing." }
    }
}
